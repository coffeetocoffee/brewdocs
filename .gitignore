# Dependencies
node_modules/

# Build / generated output
dist/
dist-*/
hosting/
docs-site/
gallery/
*.tsbuildinfo

# v2.0 incremental extraction cache (keep .brewdocs/coverage.json trend history)
.brewdocs/extract.json

# v4.1 render cache (per-page HTML keyed on model + options)
.brewdocs/render.json

# Python (adapter test artifacts)
__pycache__/
*.pyc

# Local-only planning doc (per request)
ROADMAP.md

# Vitest JSON reporter scratch (used to count cases when auditing)
.vtcount.json

# Historical local-only release notes. As of 2026-10-07 NO new notes file is
# written (user decision): the GitHub release body is the release prose's only
# home — see the AGENTS.md release procedure. This rule stays so the existing
# files on disk remain ignored. RELEASE_NOTES_v3.7.0.md was committed by
# mistake before the rule was written down; it is untracked again in v3.8.
RELEASE_NOTES_*.md

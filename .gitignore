# Dependencies
node_modules/

# Build / generated output
dist/
dist-*/
hosting/
docs-site/
gallery/
*.tsbuildinfo

# v2.0 incremental extraction cache (keep .brewdocs/coverage.json trend history)
.brewdocs/extract.json

# v4.1 render cache (per-page HTML keyed on model + options)
.brewdocs/render.json

# Python (adapter test artifacts)
__pycache__/
*.pyc

# Local-only planning doc (per request)
ROADMAP.md

# Vitest JSON reporter scratch (used to count cases when auditing)
.vtcount.json

# Local-only release notes. Per the release procedure (AGENTS.md), notes go
# into the GitHub release body via `gh release create --notes-file` and the
# file itself stays uncommitted. RELEASE_NOTES_v3.7.0.md was committed by
# mistake before this rule was written down; it is untracked again in v3.8.
RELEASE_NOTES_*.md

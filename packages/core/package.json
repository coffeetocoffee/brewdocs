{
  "name": "@brewdocs/core",
  "version": "4.3.0",
  "description": "Core extraction pipeline for BrewDocs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeetocoffee/brewdocs.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}

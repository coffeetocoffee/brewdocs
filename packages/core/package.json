{
  "name": "@brewdocs/core",
  "version": "3.0.0",
  "description": "Core extraction pipeline for BrewDocs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeetocoffee/brewdocs.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schemas",
    "README.md",
    "!src/**/*.test.ts",
    "!src/__snapshots__"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@brewdocs/core": ["./node_modules/@brewdocs/core/src/index.ts"],
      "@brewdocs/plugin-sdk": ["./node_modules/@brewdocs/plugin-sdk/src/index.ts"]
    }
  }
}
